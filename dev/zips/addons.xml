<addon id="script.centerstage"
       name="Center Stage"
       version="0.0.1.dev20261022.012728"
       provider-name="b-pass">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <!-- the title list as a folder, for widgets and skins (plugin://script.centerstage/...).
       Clicking the add-on runs RunAddon, which prefers the plugin: it opens the Programs window
       on the plugin's root, which opens ours. With no content type RunAddon does nothing. It
       comes first, so it's the add-on's main type: Kodi's add-on widgets list an add-on as a
       folder only then, and otherwise click it with PlayMedia. -->
  <extension point="xbmc.python.pluginsource" library="plugin.py">
    <provides>executable</provides>
  </extension>
  <!-- the window; listed under Programs -->
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <item library="context.py">
        <label>32000</label>
        <visible>!ListItem.IsParentFolder + !String.StartsWith(ListItem.FolderPath,plugin://script.centerstage) + [String.StartsWith(ListItem.FolderPath,plugin://) | String.StartsWith(ListItem.FolderPath,pvr://recordings) | String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,episode)]</visible>
      </item>
    </menu>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Your shows, recordings and add-on favourites in one place.</summary>
    <description lang="en_GB">One list of everything you watch: PVR recordings appear automatically, and you can add library shows, seasons and movies, and shows or videos from other add-ons, with "Add to Center Stage" in the context menu. Pick a title to see its episodes and details; pick an episode to play it.</description>
    <platform>all</platform>
    <language>en</language>
    <license>The Unlicense</license>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
