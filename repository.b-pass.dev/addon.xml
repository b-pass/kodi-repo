<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.b-pass.dev"
       name="b-pass Add-on Repository (dev)"
       version="1.0.0"
       provider-name="b-pass">
  <extension point="xbmc.addon.repository" name="b-pass github Add-on Repository (dev)">
    <dir>
      <info compressed="false">https://b-pass.github.io/kodi-repo/dev/zips/addons.xml</info>
      <checksum verify="sha256">https://b-pass.github.io/kodi-repo/dev/zips/addons.xml.sha256</checksum>
      <datadir zip="true">https://b-pass.github.io/kodi-repo/dev/zips/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_US">Development builds of add-ons by b-pass</summary>
    <description lang="en_US">Installs and keeps up to date the latest development (main branch) builds of the Kodi add-ons written by b-pass. These may be broken at any time; use the regular b-pass repository for released versions.</description>
    <platform>all</platform>
    <license>The Unlicense</license>
    <source>https://github.com/b-pass/kodi-repo</source>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
